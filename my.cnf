[mysqld]
# Allocate ~40-50% of system RAM if DB is co-located with apps (set to 1.5GB for a 4GB system)
innodb_buffer_pool_size = 1536M

# Log handling buffers
innodb_log_buffer_size = 16M

# Maximum simultaneous connections allowed to avoid RAM exhaustion spikes
max_connections = 100

# Thread cache performance improvements
thread_cache_size = 16
